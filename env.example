# Copie para .env (local) ou configure como Environment Variables no Render

BETSAPI_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_ALERTAS=
TELEGRAM_CHAT_ID_SIMULACAO=

# Cole aqui o CONTEÚDO do JSON da service account do Google (uma linha só)
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_NAME=Under Backtest

# Caminho do disco persistente configurado no Render
STATE_FILE_PATH=/data/state.json

# true pra ignorar placar 0x0 e janela de minuto (só pra validar o fluxo até a planilha)
MODO_TESTE=false
